# SYNAPSE — configuração (copie para automation/config.env e ajuste)
# Precedência: automation/config.env > variáveis de ambiente > padrões embutidos.

# Binário do Kimi Code CLI (deve estar no PATH ou caminho absoluto)
KIMI_BIN=kimi

# Modelo opcional (deixe vazio para o padrão do CLI)
# KIMI_MODEL=

# Timeout em segundos para cada invocação do kimi (0 = sem timeout)
# Requer o comando GNU `timeout` disponível (Git Bash e Linux têm)
KIMI_TIMEOUT=0

# 1 = desativa a classificação por IA (o fallback determinístico ainda roda
# e grava a entrada básica + CHANGELOG.md). 0 = comportamento normal.
SYNAPSE_DISABLE=0

# Pastas de saída (relativas à raiz do repo onde o hook foi instalado)
SYNAPSE_ENTRIES_DIR=changelog/entries
SYNAPSE_CHANGELOG=changelog/CHANGELOG.md
SYNAPSE_REPORT=reports/latest.md

# 1 = ao final, commita automaticamente os artefatos (entrada + CHANGELOG +
# relatório) com a marca [synapse] na mensagem. O hook ignora commits com essa
# marca, então não há loop infinito. 0 = deixa os artefatos no working tree.
SYNAPSE_AUTO_COMMIT=1
